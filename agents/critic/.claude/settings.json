{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "additionalDirectories": [
      "<GROUPBUILD_DIR>/workspaces/builder/project"
    ],
    "allow": [
      "Read(/**)",
      "Read(<GROUPBUILD_DIR_RULE>/workspaces/builder/project/**)",
      "Bash(git -C <GROUPBUILD_DIR>/workspaces/builder/project log *)",
      "Bash(git -C \"<GROUPBUILD_DIR>/workspaces/builder/project\" log *)",
      "Bash(git -C <GROUPBUILD_DIR>/workspaces/builder/project diff *)",
      "Bash(git -C \"<GROUPBUILD_DIR>/workspaces/builder/project\" diff *)",
      "Bash(git -C <GROUPBUILD_DIR>/workspaces/builder/project show *)",
      "Bash(git -C \"<GROUPBUILD_DIR>/workspaces/builder/project\" show *)",
      "PowerShell(git -C <GROUPBUILD_DIR>/workspaces/builder/project log *)",
      "PowerShell(git -C \"<GROUPBUILD_DIR>/workspaces/builder/project\" log *)",
      "PowerShell(git -C <GROUPBUILD_DIR>/workspaces/builder/project diff *)",
      "PowerShell(git -C \"<GROUPBUILD_DIR>/workspaces/builder/project\" diff *)",
      "PowerShell(git -C <GROUPBUILD_DIR>/workspaces/builder/project show *)",
      "PowerShell(git -C \"<GROUPBUILD_DIR>/workspaces/builder/project\" show *)"
    ],
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Edit(<GROUPBUILD_DIR_RULE>/workspaces/builder/project/**)",
      "Bash(npx *)",
      "Bash(npm *)",
      "Bash(git add *)",
      "Bash(git -C * add *)",
      "Bash(git commit *)",
      "Bash(git -C * commit *)",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(git reset *)",
      "Bash(git -C * reset *)",
      "Bash(git checkout *)",
      "Bash(git -C * checkout *)",
      "Bash(git switch *)",
      "Bash(git -C * switch *)",
      "Bash(git revert *)",
      "Bash(git -C * revert *)",
      "Bash(git tag *)",
      "Bash(git -C * tag *)",
      "Bash(git rm *)",
      "Bash(git -C * rm *)",
      "Bash(git clean *)",
      "Bash(git -C * clean *)",
      "Bash(git stash *)",
      "Bash(git -C * stash *)",
      "Bash(git merge *)",
      "Bash(git -C * merge *)",
      "Bash(git rebase *)",
      "Bash(git -C * rebase *)",
      "Bash(git config *)",
      "Bash(git -C * config *)",
      "Bash(git remote *)",
      "Bash(git -C * remote *)",
      "PowerShell(npx *)",
      "PowerShell(npm *)",
      "PowerShell(git add *)",
      "PowerShell(git -C * add *)",
      "PowerShell(git commit *)",
      "PowerShell(git -C * commit *)",
      "PowerShell(git push *)",
      "PowerShell(git -C * push *)",
      "PowerShell(git reset *)",
      "PowerShell(git -C * reset *)",
      "PowerShell(git checkout *)",
      "PowerShell(git -C * checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git -C * switch *)",
      "PowerShell(git revert *)",
      "PowerShell(git -C * revert *)",
      "PowerShell(git tag *)",
      "PowerShell(git -C * tag *)",
      "PowerShell(git rm *)",
      "PowerShell(git -C * rm *)",
      "PowerShell(git clean *)",
      "PowerShell(git -C * clean *)",
      "PowerShell(git stash *)",
      "PowerShell(git -C * stash *)",
      "PowerShell(git merge *)",
      "PowerShell(git -C * merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git -C * rebase *)",
      "PowerShell(git config *)",
      "PowerShell(git -C * config *)",
      "PowerShell(git remote *)",
      "PowerShell(git -C * remote *)"
    ]
  }
}
